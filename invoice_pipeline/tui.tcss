/* Reviewer TUI: palette and layout from the owner's Paper mockups. */

Screen {
    background: #141411;
    color: #D6D2C6;
}

#header {
    height: 1;
    margin: 1 2 0 2;
}

#tabs {
    height: 2;
    margin: 1 2 0 2;
    border-bottom: solid #3A382F;
}

#body {
    height: 1fr;
    margin: 1 2 0 2;
}

#files {
    width: 40;
    height: 1fr;
    padding: 0 1;
    background: #141411;
    border: solid #3A382F;
    border-title-color: #A59E8F;
    scrollbar-size-vertical: 1;
}

#files:focus {
    border: solid #3A382F;
    background-tint: #141411 0%;
}

#files > .option-list--option-highlighted,
#files:focus > .option-list--option-highlighted {
    background: #26251F;
    color: #D6D2C6;
    text-style: none;
}

#detail {
    width: 1fr;
    height: 1fr;
    margin-left: 2;
    padding: 0 1;
    background: #141411;
    border: solid #3A382F;
    scrollbar-size-vertical: 1;
}

#keys {
    height: 1;
    margin: 1 2;
}
