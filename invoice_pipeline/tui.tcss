/* Reviewer TUI: palette and layout from the owner's Paper mockups. */

Screen {
    background: #141411;
    color: #D6D2C6;
}

#header {
    height: 1;
    margin: 1 2 0 2;
}

#tabs {
    height: 2;
    margin: 1 2 0 2;
    border-bottom: solid #3A382F;
}

#modes, #results {
    height: 1fr;
}

#body {
    height: 1fr;
    margin: 1 2 0 2;
}

#files {
    width: 40;
    height: 1fr;
    padding: 0 1;
    background: #141411;
    border: solid #3A382F;
    border-title-color: #A59E8F;
    scrollbar-size-vertical: 1;
}

#files:focus {
    border: solid #3A382F;
    background-tint: #141411 0%;
}

#files > .option-list--option-highlighted,
#files:focus > .option-list--option-highlighted {
    background: #26251F;
    color: #D6D2C6;
    text-style: none;
}

#detail {
    width: 1fr;
    height: 1fr;
    margin-left: 2;
    padding: 0 1;
    background: #141411;
    border: solid #3A382F;
    scrollbar-size-vertical: 1;
}

#keys {
    height: 1;
    margin: 1 2;
}

#actions {
    height: auto;
    margin-top: 1;
}

#actions Button {
    min-width: 0;
    height: 3;
    margin-right: 2;
    padding: 0 1;
    background: #141411;
    border: solid #3A382F;
    text-style: bold;
}

#actions #approve {
    background: #8DBD79;
    color: #141411;
    border: solid #8DBD79;
}

#actions #reject {
    color: #C38A76;
    border: solid #C38A76;
}

#actions #retry {
    color: #C6AC6E;
    border: solid #C6AC6E;
}

#detail-status {
    height: auto;
    margin-top: 1;
}

#detail-chips {
    height: auto;
    margin-top: 1;
}

ReasonScreen {
    align: center middle;
    background: #141411 70%;
}

#reason-box {
    width: 72;
    height: auto;
    padding: 1 2;
    background: #1C1B17;
    border: solid #3A382F;
}

#reason-input {
    margin: 1 0 0 0;
    background: #141411;
    border: solid #69655B;
}

#reason-input:focus {
    border: solid #C6AC6E;
}

#reason-error {
    height: auto;
}

/* New run: the source folder (left) and what it holds (right) */

#new_run {
    height: 1fr;
    margin: 1 2 0 2;
}

#source-pane {
    width: 1fr;
    height: 1fr;
    padding: 1 1;
    border: solid #3A382F;
    border-title-color: #A59E8F;
}

#source-row {
    height: 3;
    margin-top: 1;
    border: solid #A59E8F;
}

#source-prompt {
    width: 2;
}

#source,
#source:focus {
    height: 1;
    padding: 0;
    border: none;
    background: #141411;
    color: #D6D2C6;
}

#source-help {
    margin-top: 1;
}

#source-status {
    height: auto;
    margin-top: 1;
}

#found {
    width: 48;
    height: 1fr;
    margin-left: 2;
    padding: 0 1;
    background: #141411;
    border: solid #3A382F;
    border-title-color: #A59E8F;
    scrollbar-size-vertical: 1;
}
